# AccessGuard — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# --- Shopify (Partner Dashboard > seu app > Configurações do app) ---
# Client ID / API key do app
SHOPIFY_API_KEY=1e28e79e5c87c4bd192dc88832c41428
# Client secret do app  (NUNCA cole isso no chat — só aqui no servidor)
SHOPIFY_API_SECRET=coloque_o_client_secret_aqui
# Permissões que o app pede na instalação
SHOPIFY_SCOPES=read_products,read_themes,read_content

# --- Endereço público do app (o subdomínio com HTTPS) ---
# Sem https:// e sem barra no final
HOST=accessguard.discar.cloud

# --- Atalho: app personalizado da loja (jeito mais simples de testar) ---
# Criado no admin da loja: Configurações > Apps e canais de venda > Desenvolver apps.
# Domínio COMPLETO da loja (com o sufixo) e o token que começa com shpat_
SHOP_DOMAIN=accessguard-dev-w3coxmlw.myshopify.com
SHOP_ADMIN_TOKEN=

# --- IA de visão para gerar o texto alternativo das imagens ---
# AI_PROVIDER: "openai" (GPT) ou "anthropic" (Claude)
AI_PROVIDER=openai
# Sua chave da IA escolhida (secreta — só aqui no servidor)
AI_API_KEY=
# Opcional: modelo. Padrão OpenAI=gpt-4o-mini, Anthropic=claude-3-5-haiku-latest
AI_MODEL=

# --- Infra ---
# Porta interna do app (o reverse proxy aponta para ela)
PORT=3000
# Pasta onde os tokens das lojas são guardados (dentro do contêiner)
DATA_DIR=/app/data
